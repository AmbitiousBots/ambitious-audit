{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ambitious:audit:schema:send_report:v3",
  "title": "send_report payload, version 3",
  "description": "The report summary a bot sends to the monitoring service. It holds counts, findings, at most three recommendations and short evidence. A count the bot could not observe is null, never zero, and the visibility map lists every kind of information the bot could not see. Every text field is bounded, so it cannot carry a full conversation transcript. It has no field naming the organisation: the service takes that from the caller's credential and rejects a payload that tries to set it. Version 2 differs from version 1 in these ways: task and page counts may be null, connectors are also counted as needsGrant and initializing, accountKind is added, findings carry a kind and may be marked withheld, evidence may carry a source, and the visibility map has nine signals. Version 3 adds high or low priority to findings and recommendations and up to ten service announcements copied from check_updates. Announcement ids are unique within the report, enforced by the module.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportId",
    "period",
    "accountKind",
    "summary",
    "counts",
    "findings",
    "recommendations",
    "announcements",
    "evidence",
    "visibility",
    "moduleVersions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "reportId": {
      "$ref": "#/$defs/uuidV7"
    },
    "period": {
      "type": "object",
      "description": "The time span the report covers.",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/timestamp"
        },
        "to": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "accountKind": {
      "enum": [
        "owner",
        "guest",
        "team",
        "unknown"
      ],
      "description": "How the bot is attached to the account. unknown means no tool reported the role and nobody stated it; recommendations that depend on the role are then withheld and their findings are marked."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200,
      "description": "A plain-language summary, at most 1200 characters."
    },
    "counts": {
      "type": "object",
      "description": "Counts only; no names.",
      "additionalProperties": false,
      "required": [
        "bots",
        "routines",
        "connectors",
        "tasks",
        "pages"
      ],
      "properties": {
        "bots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Bots the collector could list."
        },
        "routines": {
          "type": "object",
          "description": "Routines by state.",
          "additionalProperties": false,
          "required": [
            "active",
            "paused",
            "failing"
          ],
          "properties": {
            "active": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Active routines."
            },
            "paused": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Paused routines."
            },
            "failing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Failing routines."
            }
          }
        },
        "connectors": {
          "type": "object",
          "description": "Connectors by status.",
          "additionalProperties": false,
          "required": [
            "ok",
            "needsAuth",
            "needsGrant",
            "initializing",
            "error"
          ],
          "properties": {
            "ok": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Connectors that work."
            },
            "needsAuth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Connectors that need to be signed in again."
            },
            "needsGrant": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Connectors this bot has not been given access to."
            },
            "initializing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Connectors still being set up."
            },
            "error": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Connectors in error."
            }
          }
        },
        "tasks": {
          "type": "object",
          "description": "Task counts.",
          "additionalProperties": false,
          "required": [
            "open",
            "stale7d",
            "blocked"
          ],
          "properties": {
            "open": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000,
              "description": "Open tasks, or null when not observed."
            },
            "stale7d": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000,
              "description": "Open tasks with no change in 7 days, or null when not observed."
            },
            "blocked": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000,
              "description": "Blocked tasks, or null when not observed."
            }
          }
        },
        "pages": {
          "type": "object",
          "description": "Page counts.",
          "additionalProperties": false,
          "required": [
            "count",
            "updated7d"
          ],
          "properties": {
            "count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000,
              "description": "Pages in the account, or null when not observed."
            },
            "updated7d": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000,
              "description": "Pages updated in the last 7 days, or null when not observed."
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "description": "What the rules found.",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "recommendations": {
      "type": "array",
      "maxItems": 3,
      "description": "At most three recommendations.",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    },
    "announcements": {
      "type": "array",
      "maxItems": 10,
      "description": "Service announcements copied from a saved check_updates result. The module keeps only id, priority and title verbatim, and enforces unique ids in code. Empty when there are none.",
      "items": {
        "$ref": "#/$defs/announcement"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 30,
      "description": "The evidence cited by the findings and recommendations.",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "visibility": {
      "$ref": "#/$defs/visibility"
    },
    "moduleVersions": {
      "type": "object",
      "description": "The version of each module that produced the report, by module name. The audit module is always listed.",
      "additionalProperties": false,
      "required": [
        "audit"
      ],
      "maxProperties": 16,
      "properties": {
        "audit": {
          "$ref": "#/$defs/semver"
        }
      },
      "patternProperties": {
        "^(?!audit$)[a-z][a-z0-9-]{0,31}$": {
          "$ref": "#/$defs/semver"
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "maxLength": 24,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$",
      "description": "An instant in UTC, written as YYYY-MM-DDTHH:MM:SSZ with optional milliseconds."
    },
    "uuidV7": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "A version 7 UUID in lower case."
    },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "description": "A semantic version, such as 0.1.0."
    },
    "evidenceId": {
      "type": "string",
      "maxLength": 9,
      "pattern": "^ev-[1-9][0-9]{0,5}$",
      "description": "The id of one piece of evidence, such as ev-1."
    },
    "evidenceIds": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceId"
      },
      "description": "Ids of entries in the evidence list."
    },
    "finding": {
      "type": "object",
      "description": "One finding.",
      "additionalProperties": false,
      "required": [
        "kind",
        "ruleId",
        "severity",
        "evidenceIds",
        "summary",
        "priority"
      ],
      "properties": {
        "kind": {
          "enum": [
            "rule",
            "visibility"
          ],
          "description": "rule for a finding made by a rule from observed values; visibility for a finding that says a kind of information was not observed."
        },
        "ruleId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "The rule that produced the finding."
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "How much the finding matters."
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "description": "One or two plain sentences."
        },
        "withheld": {
          "enum": [
            "roleUnknown"
          ],
          "description": "Present when the recommendation that goes with this finding was withheld because the account role is unknown."
        },
        "priority": {
          "enum": [
            "high",
            "low"
          ],
          "description": "The priority decided by the audit rules."
        }
      }
    },
    "recommendation": {
      "type": "object",
      "description": "One recommendation, backed by evidence.",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "why",
        "evidenceIds",
        "effort",
        "priority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "The recommendation's id."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "A short title."
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "Why this is worth doing, in plain words."
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceId"
          },
          "description": "At least one id from the evidence list."
        },
        "effort": {
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "description": "Roughly how much work it is."
        },
        "priority": {
          "enum": [
            "high",
            "low"
          ],
          "description": "The priority decided by the audit rules."
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "One piece of evidence.",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/evidenceId"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "description": "The evidence itself, at most 280 characters."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "The bot id, routine id, connector name or tool the evidence came from."
        }
      }
    },
    "visibilityEntry": {
      "type": "object",
      "description": "Whether one kind of information was visible to the bot.",
      "additionalProperties": false,
      "required": [
        "signal",
        "seen",
        "why"
      ],
      "properties": {
        "signal": {
          "enum": [
            "transcripts",
            "usage",
            "otherBots",
            "auditLog",
            "accountRole",
            "tasks",
            "pages",
            "botActivity",
            "routines"
          ],
          "description": "The kind of information this entry is about: transcripts (conversation text), usage (usage figures for bots and routines), otherBots (bots other than the one collecting), auditLog (the account's audit log), accountRole (how the bot is attached to the account), tasks (task counts), pages (page counts), botActivity (when each bot was last active), routines (each bot's routine count and when each routine last ran)."
        },
        "seen": {
          "type": "boolean",
          "description": "Whether the bot could read this kind of information."
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "description": "Plain words: how it was seen, or why it could not be."
        }
      }
    },
    "visibility": {
      "type": "array",
      "description": "The visibility map: exactly one entry for each signal, so nothing unseen is left out.",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/visibilityEntry"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "transcripts"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "usage"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "otherBots"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "auditLog"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "accountRole"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "tasks"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "pages"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "botActivity"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "routines"
              }
            }
          }
        }
      ]
    },
    "announcement": {
      "type": "object",
      "description": "One service announcement; its id, priority and title are copied verbatim from check_updates.",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "description": "The service announcement id."
        },
        "priority": {
          "enum": [
            "high",
            "low"
          ],
          "description": "The priority published by the service."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "The title published by the service, copied without rewriting."
        }
      }
    }
  }
}
