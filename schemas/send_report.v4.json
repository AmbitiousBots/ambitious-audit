{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ambitious:audit:schema:send_report:v4",
  "title": "send_report payload, version 4",
  "description": "Account report with bot and connector display names, observed usage, activity, counts, findings, recommendations, evidence and service announcements. The visibility map describes coverage. Keep tokens, credentials and transcripts out of every field. The service identifies the organisation from the caller.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportId",
    "period",
    "accountKind",
    "summary",
    "counts",
    "findings",
    "recommendations",
    "announcements",
    "evidence",
    "visibility",
    "moduleVersions",
    "bots",
    "connectors",
    "planUsage"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "reportId": {
      "$ref": "#/$defs/uuidV7"
    },
    "period": {
      "type": "object",
      "description": "The time span the report covers.",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/timestamp"
        },
        "to": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "accountKind": {
      "enum": [
        "owner",
        "guest",
        "team",
        "unknown"
      ],
      "description": "How the bot is attached to the account. unknown means no tool reported the role and nobody stated it; recommendations that depend on the role are then withheld and their findings are marked."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200,
      "description": "A plain-language summary, at most 1200 characters."
    },
    "counts": {
      "type": "object",
      "description": "Counts from account tools. Unknown totals are null.",
      "additionalProperties": false,
      "required": [
        "bots",
        "routines",
        "connectors",
        "tasks",
        "pages"
      ],
      "properties": {
        "bots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Bots the collector could list."
        },
        "routines": {
          "type": "object",
          "description": "Routines by state.",
          "additionalProperties": false,
          "required": [
            "active",
            "paused",
            "failing",
            "runs7d",
            "failedRuns7d"
          ],
          "properties": {
            "active": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000,
              "description": "Active routines."
            },
            "paused": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000,
              "description": "Paused routines."
            },
            "failing": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000,
              "description": "Failing routines."
            },
            "runs7d": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000000,
              "description": "Routine runs in the last seven days, or null when an input to the total is unknown."
            },
            "failedRuns7d": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000000,
              "description": "Failed routine runs in the last seven days, or null when an input to the total is unknown."
            }
          }
        },
        "connectors": {
          "type": "object",
          "description": "Connectors by status.",
          "additionalProperties": false,
          "required": [
            "ok",
            "needsAuth",
            "needsGrant",
            "initializing",
            "error"
          ],
          "properties": {
            "ok": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Connectors that work."
            },
            "needsAuth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Connectors that need to be signed in again."
            },
            "needsGrant": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Connectors this bot has not been given access to."
            },
            "initializing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Connectors still being set up."
            },
            "error": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Connectors in error."
            }
          }
        },
        "tasks": {
          "type": "object",
          "description": "Task counts.",
          "additionalProperties": false,
          "required": [
            "open",
            "stale7d",
            "blocked",
            "closed7d"
          ],
          "properties": {
            "open": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000,
              "description": "Open tasks, or null when not observed."
            },
            "stale7d": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000,
              "description": "Open tasks with no change in 7 days, or null when not observed."
            },
            "blocked": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000,
              "description": "Blocked tasks, or null when not observed."
            },
            "closed7d": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000,
              "description": "Tasks closed in the last seven days, or null when unobserved."
            }
          }
        },
        "pages": {
          "type": "object",
          "description": "Page counts.",
          "additionalProperties": false,
          "required": [
            "count",
            "updated7d"
          ],
          "properties": {
            "count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000,
              "description": "Pages in the account, or null when not observed."
            },
            "updated7d": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000,
              "description": "Pages updated in the last 7 days, or null when not observed."
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "description": "What the rules found.",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "recommendations": {
      "type": "array",
      "maxItems": 3,
      "description": "At most three recommendations.",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    },
    "announcements": {
      "type": "array",
      "maxItems": 10,
      "description": "Service announcements copied from a saved check_updates result. The module keeps only id, priority and title verbatim, and enforces unique ids in code. Empty when there are none.",
      "items": {
        "$ref": "#/$defs/announcement"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 30,
      "description": "The evidence cited by the findings and recommendations.",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "visibility": {
      "$ref": "#/$defs/visibility"
    },
    "moduleVersions": {
      "type": "object",
      "description": "The version of each module that produced the report, by module name. The audit module is always listed.",
      "additionalProperties": false,
      "required": [
        "audit"
      ],
      "maxProperties": 16,
      "properties": {
        "audit": {
          "$ref": "#/$defs/semver"
        }
      },
      "patternProperties": {
        "^(?!audit$)[a-z][a-z0-9-]{0,31}$": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "bots": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/bot"
      }
    },
    "connectors": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/connector"
      }
    },
    "truncated": {
      "const": true,
      "description": "Present when the byte budget omits bot or connector rows. Counts cover the full snapshot."
    },
    "planUsage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "weeklyLimitUsedPercent",
        "extraCreditsLeftUsd",
        "observedAt",
        "period"
      ],
      "properties": {
        "weeklyLimitUsedPercent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of the weekly limit consumed, as shown by the usage report."
        },
        "extraCreditsLeftUsd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Remaining extra credits in USD, to the nearest cent as reported."
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 24,
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$",
          "description": "UTC observation time supplied with the plan readings, or null."
        },
        "period": {
          "enum": [
            "this_week",
            "last_7_days",
            "last_30_days",
            null
          ],
          "description": "Period for the plan readings, or null when unavailable."
        }
      },
      "description": "Plan readings from the platform usage report. Record each missing value as null."
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "maxLength": 24,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$",
      "description": "An instant in UTC, written as YYYY-MM-DDTHH:MM:SSZ with optional milliseconds."
    },
    "uuidV7": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "A version 7 UUID in lower case."
    },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "description": "A semantic version, such as 0.1.0."
    },
    "evidenceId": {
      "type": "string",
      "maxLength": 9,
      "pattern": "^ev-[1-9][0-9]{0,5}$",
      "description": "The id of one piece of evidence, such as ev-1."
    },
    "evidenceIds": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceId"
      },
      "description": "Ids of entries in the evidence list."
    },
    "finding": {
      "type": "object",
      "description": "One finding.",
      "additionalProperties": false,
      "required": [
        "kind",
        "ruleId",
        "severity",
        "evidenceIds",
        "summary",
        "priority"
      ],
      "properties": {
        "kind": {
          "enum": [
            "rule",
            "visibility"
          ],
          "description": "rule for a finding made by a rule from observed values; visibility for a finding that says a kind of information was not observed."
        },
        "ruleId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "The rule that produced the finding."
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "How much the finding matters."
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "description": "One or two plain sentences."
        },
        "withheld": {
          "enum": [
            "roleUnknown"
          ],
          "description": "Present when the recommendation that goes with this finding was withheld because the account role is unknown."
        },
        "priority": {
          "enum": [
            "high",
            "low"
          ],
          "description": "The priority decided by the audit rules."
        }
      }
    },
    "recommendation": {
      "type": "object",
      "description": "One recommendation, backed by evidence.",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "why",
        "evidenceIds",
        "effort",
        "priority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "The recommendation's id."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "A short title."
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "Why this is worth doing, in plain words."
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceId"
          },
          "description": "At least one id from the evidence list."
        },
        "effort": {
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "description": "Roughly how much work it is."
        },
        "priority": {
          "enum": [
            "high",
            "low"
          ],
          "description": "The priority decided by the audit rules."
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "One piece of evidence.",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/evidenceId"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "description": "The evidence itself, at most 280 characters."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "The bot id, routine id, connector name or tool the evidence came from."
        }
      }
    },
    "visibilityEntry": {
      "type": "object",
      "description": "Whether one kind of information was visible to the bot.",
      "additionalProperties": false,
      "required": [
        "signal",
        "seen",
        "why"
      ],
      "properties": {
        "signal": {
          "enum": [
            "transcripts",
            "usage",
            "otherBots",
            "auditLog",
            "accountRole",
            "tasks",
            "pages",
            "botActivity",
            "routines"
          ],
          "description": "The observed signal. usage covers bot, routine and plan readings. tasks includes closures. routines covers inventory, last runs and seven-day run and failure counts."
        },
        "seen": {
          "enum": [
            true,
            false,
            "partial"
          ],
          "description": "Use true for complete observation, false for no observation and partial for incomplete observation. Explain the missing information in why."
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "description": "Plain words: how it was seen, or why it could not be."
        }
      }
    },
    "visibility": {
      "type": "array",
      "description": "The visibility map: exactly one entry for each signal, so nothing unseen is left out.",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/visibilityEntry"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "transcripts"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "usage"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "otherBots"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "auditLog"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "accountRole"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "tasks"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "pages"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "botActivity"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "routines"
              }
            }
          }
        }
      ]
    },
    "announcement": {
      "type": "object",
      "description": "One service announcement; its id, priority and title are copied verbatim from check_updates.",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "description": "The service announcement id."
        },
        "priority": {
          "enum": [
            "high",
            "low"
          ],
          "description": "The priority published by the service."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "The title published by the service, copied without rewriting."
        }
      }
    },
    "bot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "usageShare",
        "usageShareBelow",
        "usagePeriod",
        "lastActiveAt",
        "routineCount"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "The bot's display name as the account shows it."
        },
        "usageShare": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Exact fraction of usage in usagePeriod, or null."
        },
        "usageShareBelow": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Exclusive upper bound on the share, or null. A value of 0.01 represents <1%."
        },
        "usagePeriod": {
          "enum": [
            "this_week",
            "last_7_days",
            "last_30_days",
            null
          ],
          "description": "Period of the exact share or upper bound, or null when neither was reported."
        },
        "lastActiveAt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 24,
          "pattern": "^(never|[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z)$",
          "description": "An instant in UTC written as YYYY-MM-DDTHH:MM:SSZ with optional milliseconds, the word never when the account shows it has not happened yet, or null when the bot could not observe it."
        },
        "routineCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100000,
          "description": "How many routines the bot has, or null when not observed."
        },
        "usagePeriodStart": {
          "$ref": "#/$defs/timestamp",
          "description": "The start of the share period in UTC, when supplied by the usage report."
        },
        "usagePeriodEnd": {
          "$ref": "#/$defs/timestamp",
          "description": "The end of the share period in UTC, when supplied by the usage report."
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "usageShare": {
              "type": "number"
            },
            "usageShareBelow": {
              "type": "null"
            },
            "usagePeriod": {
              "enum": [
                "this_week",
                "last_7_days",
                "last_30_days"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "usageShare": {
              "type": "null"
            },
            "usageShareBelow": {
              "type": "number"
            },
            "usagePeriod": {
              "enum": [
                "this_week",
                "last_7_days",
                "last_30_days"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "usageShare": {
              "type": "null"
            },
            "usageShareBelow": {
              "type": "null"
            },
            "usagePeriod": {
              "enum": [
                null
              ]
            },
            "usagePeriodStart": false,
            "usagePeriodEnd": false
          }
        }
      ]
    },
    "connector": {
      "type": "object",
      "description": "One connector.",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "The connector's display name as the account shows it."
        },
        "status": {
          "enum": [
            "ok",
            "needsAuth",
            "needsGrant",
            "initializing",
            "error"
          ],
          "description": "The connector's current status: ok (working), needsAuth (it must be signed in again), needsGrant (it is connected, but this bot has not been given access to it), initializing (still being set up), error (failing for another reason)."
        }
      }
    }
  }
}
