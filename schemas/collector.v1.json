{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ambitious:audit:schema:collector:v1",
  "title": "Collector input, version 1",
  "description": "What a bot gathered about its own account with its own tools, as input to the snapshot command. Every text field is short and bounded, so the file cannot carry a full conversation transcript.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "collectedAt",
    "account",
    "bots",
    "routines",
    "connectors",
    "tasks",
    "pages",
    "visibility",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "collectedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "account": {
      "type": "object",
      "description": "The account the bot looked at.",
      "additionalProperties": false,
      "required": [
        "kind",
        "label"
      ],
      "properties": {
        "kind": {
          "enum": [
            "owner",
            "guest",
            "team"
          ],
          "description": "How the bot is attached to the account."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "A short display label for the account."
        }
      }
    },
    "bots": {
      "type": "array",
      "maxItems": 200,
      "description": "The bots the collector could list.",
      "items": {
        "$ref": "#/$defs/bot"
      }
    },
    "routines": {
      "type": "array",
      "maxItems": 1000,
      "description": "The routines the collector could list.",
      "items": {
        "$ref": "#/$defs/routine"
      }
    },
    "connectors": {
      "type": "array",
      "maxItems": 200,
      "description": "The connectors the collector could list.",
      "items": {
        "$ref": "#/$defs/connector"
      }
    },
    "tasks": {
      "type": "object",
      "description": "Task counts.",
      "additionalProperties": false,
      "required": [
        "open",
        "stale7d",
        "blocked"
      ],
      "properties": {
        "open": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Open tasks."
        },
        "stale7d": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Open tasks with no change in 7 days."
        },
        "blocked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Blocked tasks."
        }
      }
    },
    "pages": {
      "type": "object",
      "description": "Page counts.",
      "additionalProperties": false,
      "required": [
        "count",
        "updated7d"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Pages in the account."
        },
        "updated7d": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Pages updated in the last 7 days."
        }
      }
    },
    "visibility": {
      "$ref": "#/$defs/visibility"
    },
    "evidence": {
      "type": "array",
      "maxItems": 200,
      "description": "Short pieces of evidence that findings and recommendations cite by id.",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "maxLength": 24,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$",
      "description": "An instant in UTC, written as YYYY-MM-DDTHH:MM:SSZ with optional milliseconds."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "An identifier as the account shows it."
    },
    "bot": {
      "type": "object",
      "description": "One bot.",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "lastActiveAt",
        "routineCount",
        "usage"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "The bot's display name."
        },
        "lastActiveAt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 24,
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$",
          "description": "When the bot was last active, or null if it has never been active."
        },
        "routineCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "description": "How many routines the bot has."
        },
        "usage": {
          "type": "object",
          "description": "Usage figures for the bot.",
          "additionalProperties": false,
          "required": [
            "credits7d"
          ],
          "properties": {
            "credits7d": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000000,
              "description": "Credits used in the last 7 days, or null when usage could not be seen."
            }
          }
        }
      }
    },
    "routine": {
      "type": "object",
      "description": "One routine.",
      "additionalProperties": false,
      "required": [
        "id",
        "botId",
        "schedule",
        "state",
        "lastRunAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "botId": {
          "$ref": "#/$defs/id"
        },
        "schedule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "The schedule as the account shows it."
        },
        "state": {
          "enum": [
            "active",
            "paused",
            "failing"
          ],
          "description": "The routine's current state."
        },
        "lastRunAt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 24,
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$",
          "description": "When the routine last ran, or null if it has never run."
        },
        "lastError": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "description": "A short excerpt of the last error."
        }
      }
    },
    "connector": {
      "type": "object",
      "description": "One connector.",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "The connector's name."
        },
        "status": {
          "enum": [
            "ok",
            "needsAuth",
            "error"
          ],
          "description": "The connector's current status."
        }
      }
    },
    "visibilityEntry": {
      "type": "object",
      "description": "Whether one kind of information was visible to the bot.",
      "additionalProperties": false,
      "required": [
        "signal",
        "seen",
        "why"
      ],
      "properties": {
        "signal": {
          "enum": [
            "transcripts",
            "usage",
            "otherBots",
            "auditLog"
          ],
          "description": "The kind of information this entry is about."
        },
        "seen": {
          "type": "boolean",
          "description": "Whether the bot could read this kind of information."
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "description": "Plain words: how it was seen, or why it could not be."
        }
      }
    },
    "visibility": {
      "type": "array",
      "description": "The visibility map: exactly one entry for each signal, so nothing unseen is left out.",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/visibilityEntry"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "transcripts"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "usage"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "otherBots"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "auditLog"
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "description": "One piece of evidence.",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/evidenceId"
        },
        "kind": {
          "enum": [
            "excerpt",
            "count"
          ],
          "description": "A short quote, or a number with its unit."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "description": "The evidence itself, at most 280 characters."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "The bot id or tool the evidence came from."
        }
      }
    },
    "evidenceId": {
      "type": "string",
      "maxLength": 9,
      "pattern": "^ev-[1-9][0-9]{0,5}$",
      "description": "The id of one piece of evidence, such as ev-1."
    }
  }
}
