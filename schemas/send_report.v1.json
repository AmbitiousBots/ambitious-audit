{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ambitious:audit:schema:send_report:v1",
  "title": "send_report payload, version 1",
  "description": "The report summary a bot sends to the monitoring service. It holds counts, findings, at most three recommendations and short evidence. Every text field is bounded, so it cannot carry a full conversation transcript. It has no field naming the organisation: the service takes that from the caller's credential and rejects a payload that tries to set it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportId",
    "period",
    "summary",
    "counts",
    "findings",
    "recommendations",
    "evidence",
    "visibility",
    "moduleVersions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "reportId": {
      "$ref": "#/$defs/uuidV7"
    },
    "period": {
      "type": "object",
      "description": "The time span the report covers.",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/timestamp"
        },
        "to": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200,
      "description": "A plain-language summary, at most 1200 characters."
    },
    "counts": {
      "type": "object",
      "description": "Counts only; no names.",
      "additionalProperties": false,
      "required": [
        "bots",
        "routines",
        "connectors",
        "tasks",
        "pages"
      ],
      "properties": {
        "bots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Bots seen."
        },
        "routines": {
          "type": "object",
          "description": "Routines by state.",
          "additionalProperties": false,
          "required": [
            "active",
            "paused",
            "failing"
          ],
          "properties": {
            "active": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Active routines."
            },
            "paused": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Paused routines."
            },
            "failing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Failing routines."
            }
          }
        },
        "connectors": {
          "type": "object",
          "description": "Connectors by status.",
          "additionalProperties": false,
          "required": [
            "ok",
            "needsAuth",
            "error"
          ],
          "properties": {
            "ok": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Connectors that work."
            },
            "needsAuth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Connectors that need to be signed in again."
            },
            "error": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Connectors in error."
            }
          }
        },
        "tasks": {
          "type": "object",
          "description": "Task counts.",
          "additionalProperties": false,
          "required": [
            "open",
            "stale7d",
            "blocked"
          ],
          "properties": {
            "open": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Open tasks."
            },
            "stale7d": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Open tasks with no change in 7 days."
            },
            "blocked": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Blocked tasks."
            }
          }
        },
        "pages": {
          "type": "object",
          "description": "Page counts.",
          "additionalProperties": false,
          "required": [
            "count",
            "updated7d"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Pages in the account."
            },
            "updated7d": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Pages updated in the last 7 days."
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "description": "What the rules found.",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "recommendations": {
      "type": "array",
      "maxItems": 3,
      "description": "At most three recommendations.",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 30,
      "description": "The evidence cited by the findings and recommendations.",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "visibility": {
      "$ref": "#/$defs/visibility"
    },
    "moduleVersions": {
      "type": "object",
      "description": "The version of each module that produced the report, by module name. The audit module is always listed.",
      "additionalProperties": false,
      "required": [
        "audit"
      ],
      "maxProperties": 16,
      "properties": {
        "audit": {
          "$ref": "#/$defs/semver"
        }
      },
      "patternProperties": {
        "^(?!audit$)[a-z][a-z0-9-]{0,31}$": {
          "$ref": "#/$defs/semver"
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "maxLength": 24,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$",
      "description": "An instant in UTC, written as YYYY-MM-DDTHH:MM:SSZ with optional milliseconds."
    },
    "uuidV7": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "A version 7 UUID in lower case."
    },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "description": "A semantic version, such as 0.1.0."
    },
    "evidenceId": {
      "type": "string",
      "maxLength": 9,
      "pattern": "^ev-[1-9][0-9]{0,5}$",
      "description": "The id of one piece of evidence, such as ev-1."
    },
    "evidenceIds": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceId"
      },
      "description": "Ids of entries in the evidence list."
    },
    "finding": {
      "type": "object",
      "description": "One finding.",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "severity",
        "evidenceIds",
        "summary"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "The rule that produced the finding."
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "How much the finding matters."
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "description": "One or two plain sentences."
        }
      }
    },
    "recommendation": {
      "type": "object",
      "description": "One recommendation, backed by evidence.",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "why",
        "evidenceIds",
        "effort"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "The recommendation's id."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "A short title."
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "Why this is worth doing, in plain words."
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceId"
          },
          "description": "At least one id from the evidence list."
        },
        "effort": {
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "description": "Roughly how much work it is."
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "One piece of evidence.",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/evidenceId"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "description": "The evidence itself, at most 280 characters."
        }
      }
    },
    "visibilityEntry": {
      "type": "object",
      "description": "Whether one kind of information was visible to the bot.",
      "additionalProperties": false,
      "required": [
        "signal",
        "seen",
        "why"
      ],
      "properties": {
        "signal": {
          "enum": [
            "transcripts",
            "usage",
            "otherBots",
            "auditLog"
          ],
          "description": "The kind of information this entry is about."
        },
        "seen": {
          "type": "boolean",
          "description": "Whether the bot could read this kind of information."
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "description": "Plain words: how it was seen, or why it could not be."
        }
      }
    },
    "visibility": {
      "type": "array",
      "description": "The visibility map: exactly one entry for each signal, so nothing unseen is left out.",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/visibilityEntry"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "transcripts"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "usage"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "otherBots"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "const": "auditLog"
              }
            }
          }
        }
      ]
    }
  }
}
