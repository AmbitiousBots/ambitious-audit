{
  "id": "paused-routine-since-unknown",
  "severity": "low",
  "effort": "small",
  "rank": 45,
  "dependsOnRole": true,
  "title": "Check whether the paused routine is paused on purpose",
  "why": "A paused routine does no work. The account did not show when this one was paused, so how long it has been paused is not known. Check that it is paused on purpose; resume it or remove it if it is not.",
  "summary": {
    "one": "1 routine is paused, and the account did not show since when.",
    "many": "{count} routines are paused, and the account did not show since when."
  },
  "when": { "kind": "routine-paused-since-unknown", "unlessCreatedOrRunWithinDays": 7 },
  "fixtures": [
    {
      "name": "a paused routine with no pause time whose last run was not observed",
      "expect": "hit",
      "routines": [
        { "id": "routine-1", "botId": "bot-1", "schedule": "every day at 08:00", "state": "paused", "lastRunAt": null, "usage": null }
      ]
    },
    {
      "name": "a paused routine with no pause time that has never run",
      "expect": "hit",
      "routines": [
        { "id": "routine-1", "botId": "bot-1", "schedule": "every day at 08:00", "state": "paused", "lastRunAt": "never", "usage": null }
      ]
    },
    {
      "name": "a paused routine with no pause time that last ran 14 days before",
      "expect": "hit",
      "routines": [
        { "id": "routine-1", "botId": "bot-1", "schedule": "every day at 08:00", "state": "paused", "lastRunAt": "2026-11-01T00:00:00Z", "usage": null }
      ]
    },
    {
      "name": "a paused routine with no pause time that was created 20 days before and has never run",
      "expect": "hit",
      "routines": [
        { "id": "routine-1", "botId": "bot-1", "schedule": "every day at 08:00", "state": "paused", "lastRunAt": "never", "createdAt": "2026-10-26T00:00:00Z", "usage": null }
      ]
    },
    {
      "name": "a routine created paused on the day of the snapshot",
      "expect": "miss",
      "routines": [
        { "id": "routine-1", "botId": "bot-1", "schedule": "every day at 08:00", "state": "paused", "lastRunAt": "never", "createdAt": "2026-11-14T09:00:00Z", "usage": null }
      ]
    },
    {
      "name": "a paused routine with no pause time that ran the day before",
      "expect": "miss",
      "routines": [
        { "id": "routine-1", "botId": "bot-1", "schedule": "every day at 08:00", "state": "paused", "lastRunAt": "2026-11-14T00:00:00Z", "usage": null }
      ]
    },
    {
      "name": "a paused routine whose pause time is given",
      "expect": "miss",
      "routines": [
        { "id": "routine-1", "botId": "bot-1", "schedule": "every day at 08:00", "state": "paused", "lastRunAt": "2026-11-01T00:00:00Z", "pausedAt": "2026-11-07T00:00:00Z", "usage": null }
      ]
    },
    {
      "name": "an active routine",
      "expect": "miss",
      "routines": [
        { "id": "routine-1", "botId": "bot-1", "schedule": "every day at 08:00", "state": "active", "lastRunAt": "never", "usage": null }
      ]
    }
  ]
}
