{
  "id": "bot-unused",
  "severity": "medium",
  "effort": "small",
  "rank": 40,
  "dependsOnRole": true,
  "title": "Decide what to do with the unused bot",
  "why": "A bot with no activity for 14 days may be forgotten. Use it, or remove it if it is no longer needed.",
  "summary": {
    "one": "1 bot has not been used for more than 14 days.",
    "many": "{count} bots have not been used for more than 14 days."
  },
  "when": { "kind": "bot-unused", "olderThanDays": 14 },
  "fixtures": [
    {
      "name": "the bot's routine recorded six successful runs this week",
      "expect": "miss",
      "bots": [
        { "id": "bot-1", "name": "Work queue", "lastActiveAt": "2026-10-01T00:00:00Z", "routineCount": 1, "usage": null }
      ],
      "routines": [
        { "id": "routine-1", "botId": "bot-1", "schedule": "daily", "state": "active", "lastRunAt": null, "runs7d": 6, "failedRuns7d": 0, "usage": null }
      ]
    },
    {
      "name": "the bot has a zero monthly share and its routine ran exactly fourteen days ago",
      "expect": "miss",
      "bots": [
        { "id": "bot-1", "name": "Work queue", "lastActiveAt": null, "routineCount": 1, "usage": { "unit": "share", "period": "last_30_days", "share": 0 } }
      ],
      "routines": [
        { "id": "routine-1", "botId": "bot-1", "schedule": "daily", "state": "paused", "lastRunAt": "2026-11-01T00:00:00Z", "runs7d": 0, "usage": null }
      ]
    },
    {
      "name": "both routine timestamps fall outside the inactivity window",
      "expect": "hit",
      "bots": [
        { "id": "bot-1", "name": "Work queue", "lastActiveAt": "never", "routineCount": 2, "usage": null }
      ],
      "routines": [
        { "id": "routine-1", "botId": "bot-1", "schedule": "daily", "state": "active", "lastRunAt": "2026-10-31T23:59:59Z", "usage": null },
        { "id": "routine-2", "botId": "bot-1", "schedule": "weekly", "state": "active", "lastRunAt": "2026-11-15T00:00:01Z", "usage": null }
      ]
    },
    {
      "name": "the September zero-share interval ended before the November snapshot",
      "expect": "miss",
      "bots": [
        { "id": "bot-1", "name": "Work queue", "lastActiveAt": null, "routineCount": null, "usage": { "unit": "share", "period": "last_30_days", "periodStart": "2026-09-01T00:00:00Z", "periodEnd": "2026-10-01T00:00:00Z", "share": 0 } }
      ]
    },
    {
      "name": "the zero-share interval ended one second before the snapshot",
      "expect": "miss",
      "bots": [
        { "id": "bot-1", "name": "Work queue", "lastActiveAt": null, "routineCount": null, "usage": { "unit": "share", "period": "last_30_days", "periodEnd": "2026-11-14T23:59:59Z", "share": 0 } }
      ]
    },
    {
      "name": "the zero-share interval covers more than fourteen days through the snapshot",
      "expect": "hit",
      "bots": [
        { "id": "bot-1", "name": "Work queue", "lastActiveAt": null, "routineCount": null, "usage": { "unit": "share", "period": "last_30_days", "periodStart": "2026-10-16T00:00:00Z", "share": 0 } }
      ]
    },
    {
      "name": "the zero-share interval began exactly fourteen days before the snapshot",
      "expect": "miss",
      "bots": [
        { "id": "bot-1", "name": "Work queue", "lastActiveAt": null, "routineCount": null, "usage": { "unit": "share", "period": "last_30_days", "periodStart": "2026-11-01T00:00:00Z", "periodEnd": "2026-11-15T00:00:00Z", "share": 0 } }
      ]
    },
    {
      "name": "a bot that has never been active",
      "expect": "hit",
      "bots": [
        { "id": "bot-1", "name": "Helper", "lastActiveAt": "never", "routineCount": 0, "usage": null }
      ]
    },
    {
      "name": "a bot last active 20 days before",
      "expect": "hit",
      "bots": [
        { "id": "bot-1", "name": "Helper", "lastActiveAt": "2026-10-26T00:00:00Z", "routineCount": 0, "usage": null }
      ]
    },
    {
      "name": "a bot whose last activity was not observed",
      "expect": "miss",
      "bots": [
        { "id": "bot-1", "name": "Helper", "lastActiveAt": null, "routineCount": null, "usage": null }
      ]
    },
    {
      "name": "a bot used the day before",
      "expect": "miss",
      "bots": [
        { "id": "bot-1", "name": "Helper", "lastActiveAt": "2026-11-14T00:00:00Z", "routineCount": 1, "usage": { "unit": "credits", "amount7d": 1 } }
      ]
    },
    {
      "name": "a bot whose last activity was not observed, listed with no share of the last 30 days of usage",
      "expect": "hit",
      "bots": [
        { "id": "bot-1", "name": "Helper", "lastActiveAt": null, "routineCount": null, "usage": { "unit": "share", "period": "last_30_days", "share": 0 } }
      ]
    },
    {
      "name": "a bot last active 20 days before, with a share of the last 30 days of usage",
      "expect": "hit",
      "bots": [
        { "id": "bot-1", "name": "Helper", "lastActiveAt": "2026-10-26T00:00:00Z", "routineCount": 0, "usage": { "unit": "share", "period": "last_30_days", "share": 0.1 } }
      ]
    },
    {
      "name": "a bot whose last activity was not observed, listed with no share of the last 7 days of usage",
      "expect": "miss",
      "bots": [
        { "id": "bot-1", "name": "Helper", "lastActiveAt": null, "routineCount": null, "usage": { "unit": "share", "period": "last_7_days", "share": 0 } }
      ]
    },
    {
      "name": "a bot whose last activity was not observed, listed with no share of this week's usage",
      "expect": "miss",
      "bots": [
        { "id": "bot-1", "name": "Helper", "lastActiveAt": null, "routineCount": null, "usage": { "unit": "share", "period": "this_week", "share": 0 } }
      ]
    },
    {
      "name": "a bot whose last activity was not observed, listed with a share of the last 30 days of usage",
      "expect": "miss",
      "bots": [
        { "id": "bot-1", "name": "Helper", "lastActiveAt": null, "routineCount": null, "usage": { "unit": "share", "period": "last_30_days", "share": 0.25 } }
      ]
    },
    {
      "name": "a bot whose last activity and usage were not observed, because the usage report did not list it by name",
      "expect": "miss",
      "bots": [
        { "id": "bot-1", "name": "Helper", "lastActiveAt": null, "routineCount": null, "usage": null },
        { "id": "bot-2", "name": "Helper", "lastActiveAt": "2026-11-14T00:00:00Z", "routineCount": 1, "usage": { "unit": "share", "period": "last_30_days", "share": 0.9 } }
      ]
    },
    {
      "name": "a bot shown as never active that has a share of this week's usage",
      "expect": "miss",
      "bots": [
        { "id": "bot-1", "name": "Helper", "lastActiveAt": "never", "routineCount": 0, "usage": { "unit": "share", "period": "this_week", "share": 0.4 } }
      ]
    },
    {
      "name": "a bot shown as last active 20 days before that used credits in the last 7 days",
      "expect": "miss",
      "bots": [
        { "id": "bot-1", "name": "Helper", "lastActiveAt": "2026-10-26T00:00:00Z", "routineCount": 0, "usage": { "unit": "credits", "amount7d": 3 } }
      ]
    }
  ]
}
