#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { mkdtempSync, readFileSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";

const root = join(import.meta.dirname, "..");
const features = JSON.parse(readFileSync(join(import.meta.dirname, "features.json"), "utf8"));
const failures = [];

for (const feature of features) {
  const home = mkdtempSync(join(tmpdir(), "ambitious-audit-verify-"));
  const result = spawnSync(feature.check, {
    cwd: root,
    shell: true,
    encoding: "utf8",
    env: { ...process.env, AMBITIOUS_HOME: home },
  });
  rmSync(home, { recursive: true, force: true });
  const ok = result.status === 0;
  process.stdout.write(`${ok ? "ok  " : "FAIL"}  ${feature.id}  ${feature.userVisible}\n`);
  if (!ok) {
    failures.push(feature.id);
    process.stderr.write(`${result.stdout ?? ""}${result.stderr ?? ""}`);
  }
}

if (failures.length > 0) {
  process.stderr.write(`verify: ${failures.join(", ")} failed\n`);
  process.exitCode = 1;
} else {
  process.stdout.write(`verify: ok. ${features.length} of ${features.length} features passed.\n`);
}
